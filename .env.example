# Database — the monitoring_ro user: read-only on the whole schema,
# INSERT+UPDATE only on T_WC_DATA_MONITORING_SNAPSHOT.
DB_HOST=your_database_host
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=monitoring_ro
DB_PASSWORD=your_readonly_password

# Report run
USER_TIMEZONE=Europe/Paris
OUTPUT_DIR=/shared
RETENTION_DAYS=30
